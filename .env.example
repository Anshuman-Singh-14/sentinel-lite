# Copy to .env (python run.py does this for you with a random SECRET_KEY).

# dev = local laptop, prod = the VPS (Secure cookies, no /api/docs, private IPs blocked)
APP_ENV=dev

# Signs the session cookie. At least 32 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# Public domain of the server (used by Caddy, and to block scans of the server itself)
DOMAIN=localhost

# Where the SQLite database file lives
DATABASE_PATH=sentinel.db

# --- Docker + Cloudflare Tunnel (see DEPLOYMENT.md) ---

# Token of your Cloudflare Tunnel (Zero Trust -> Networks -> Tunnels). Secret: never commit it.
CF_TUNNEL_TOKEN=PASTE_TOKEN_HERE

# Sites allowed to call the API from the browser (comma-separated, exact origins, never *).
# Leave empty when the frontend and API share one origin (python run.py).
ALLOWED_ORIGINS=https://sentinellite.com,https://www.sentinellite.com

# Where the frontend sends API calls. Built into the JavaScript, so rebuild after changing it.
# Leave empty when the frontend and API share one origin (python run.py, npm run dev).
VITE_API_URL=https://api.sentinellite.com
