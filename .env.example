# Copy to .env (python run.py does this for you with a random SECRET_KEY).

# dev = local laptop, prod = the VPS (Secure cookies, no /api/docs, private IPs blocked)
APP_ENV=dev

# Signs the session cookie. At least 32 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# Public domain of the server (used by Caddy, and to block scans of the server itself)
DOMAIN=localhost

# Where the SQLite database file lives
DATABASE_PATH=sentinel.db

# Every login, scan and admin change is also appended to this plain-text file.
# (In Docker, docker-compose.yml puts it at /data/activity.log instead.)
ACTIVITY_LOG_PATH=logs/activity.log

# --- Email and account requests (see DEPLOYMENT.md, "Email and account requests") ---
# In dev, leave these empty: emails are printed to the console and Turnstile uses
# Cloudflare's always-pass test keys. In prod, the "Request credentials" form is switched
# off until SMTP_HOST, both Turnstile keys and PUBLIC_URL are set.

# SMTP server. For Resend: SMTP_HOST=smtp.resend.com, SMTP_USERNAME=resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# For Resend, an API key with "Sending access". Secret: never commit it.
SMTP_PASSWORD=
MAIL_FROM=Sentinel Lite <no-reply@sentinellite.com>

# Address people open the site at, used for links in emails (e.g. https://sentinellite.com).
# Empty in dev means http://localhost:8000.
PUBLIC_URL=

# Cloudflare Turnstile widget keys (Cloudflare dashboard -> Turnstile). The secret key is secret.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Docker + Cloudflare Tunnel (see DEPLOYMENT.md) ---

# Token of your Cloudflare Tunnel (Zero Trust -> Networks -> Tunnels). Secret: never commit it.
CF_TUNNEL_TOKEN=PASTE_TOKEN_HERE

# Sites allowed to call the API from the browser (comma-separated, exact origins, never *).
# Leave empty when the frontend and API share one origin (python run.py).
ALLOWED_ORIGINS=https://sentinellite.com,https://www.sentinellite.com

# Where the frontend sends API calls. Built into the JavaScript, so rebuild after changing it.
# Leave empty when the frontend and API share one origin (python run.py, npm run dev).
VITE_API_URL=https://api.sentinellite.com
